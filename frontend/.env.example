# Bird Wanderer settings. Copy this file to .env and fill in your own values.
# Placeholders only: never commit a real .env, keys, passwords or credential files.
# Server-only secrets must never use a VITE_ prefix (that would ship them to browsers).

# --- Discovery (required for birds, hotspots and reports) ---------------------
# Free key from https://ebird.org/api/keygen
EBIRD_API_KEY=your-ebird-api-key
# eBird region code for the main area. Default: IN-DL (Delhi).
EBIRD_REGION=IN-DL
# Up to three extra comma-separated region codes. Delhi adds IN-UP-GB (Noida) by
# default for Okhla Bird Sanctuary; set it empty to use only EBIRD_REGION.
# EBIRD_ADDITIONAL_REGIONS=IN-UP-GB

# --- Allowed origin / domain -------------------------------------------------
# The exact address people open (scheme, host and port, no path). Requests from
# any other origin are rejected. Production requires https://.
APP_ORIGIN=http://localhost:3000
# Extra exact origins, comma-separated, e.g. a phone on the same Wi-Fi:
# http://192.168.1.3:3000  (production: HTTPS origins only)
ADDITIONAL_APP_ORIGINS=
# Optional exact HTTPS origin of a named Cloudflare tunnel; `pnpm dev:tunnel`
# discovers quick tunnels automatically.
TUNNEL_ORIGIN=
# Optional cloudflared executable path if it is not on PATH.
CLOUDFLARED_PATH=

# --- Server ------------------------------------------------------------------
# Leave unset for development. On the production server set NODE_ENV=production
# (it requires an HTTPS APP_ORIGIN and serves the built frontend from dist/).
# NODE_ENV=production
# API address. Keep HOST on loopback behind a reverse proxy in production.
HOST=127.0.0.1
PORT=3001
# Development only: set to 0.0.0.0 so phones on your network can open Vite.
FRONTEND_HOST=127.0.0.1

# --- Storage (keep both on a private, persistent disk, outside public folders) --
# Defaults: frontend/data/bird-wanderer.sqlite and frontend/data/media
# DATABASE_PATH=/var/lib/bird-wanderer/bird-wanderer.sqlite
# MEDIA_PATH=/var/lib/bird-wanderer/media

# --- Firebase push (optional) ------------------------------------------------
# Leave all three empty for in-app alerts only. The service-account JSON must
# live OUTSIDE this repository.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Public Firebase web app fields as one JSON line:
# {"apiKey":"your-web-api-key","authDomain":"your-project.firebaseapp.com","projectId":"your-project","messagingSenderId":"000000000000","appId":"1:000000000000:web:0000000000000000"}
FIREBASE_WEB_CONFIG=
FIREBASE_VAPID_PUBLIC_KEY=
# The Android app reads its own Firebase settings from android/firebase.properties
# (see android/firebase.properties.example).

# --- Email: password recovery and verification (optional) -----------------------
# Leave ALL SMTP fields empty to disable email. Port must be 465 or 587 (TLS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Plain sender address, e.g. birdwanderer@your-domain.example
SMTP_FROM=
# Optional exact origin used in emailed links; defaults to APP_ORIGIN and must be
# APP_ORIGIN, one of ADDITIONAL_APP_ORIGINS or the current TUNNEL_ORIGIN.
RECOVERY_ORIGIN=
